# Consolidamento canonico: forza https + non-www su https://decempionz.com
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://decempionz.com%{REQUEST_URI} [L,R=301,NE]
</IfModule>

# Header di sicurezza compatibili con l'app attuale (che usa ancora JS inline).
# CSP verra' valutata separatamente quando il codice inline sara' stato isolato.
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# Decempionz — cache control
# index.html e sw.js non devono mai essere cachati dal browser
<FilesMatch "(index\.html|sw\.js)$">
  Header set Cache-Control "no-cache, no-store, must-revalidate"
  Header set Pragma "no-cache"
  Header set Expires 0
</FilesMatch>

# Tutti gli endpoint/pagine PHP sono dinamici: niente cache condivisa o browser persistente.
<FilesMatch "\.php$">
  Header set Cache-Control "no-store, max-age=0"
  Header set Pragma "no-cache"
</FilesMatch>

# Asset statici: cache lunga (cambiano raramente)
<FilesMatch "\.(png|jpg|jpeg|gif|ico|webp|svg|woff2?|ttf)$">
  Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>

# File riservati: mai serviti via HTTP (PHP continua a leggerli da disco).
<FilesMatch "^(hof-config\.php|challenge-config\.json|GAME_MANUAL\.md|hall-of-fame-pending\.json|duel-lib\.php|duel-engine\.php|duel-draft-lib\.php|runtime-backup-lib\.php|runtime-recovery-lib\.php|runtime-recovery\.php|draft-storage-lib\.php)$">
  Require all denied
</FilesMatch>

# Grant temporanei per l'upload delle share card Draft: hash server-side, mai pubblici.
<FilesMatch "\.draft-auth$">
  Require all denied
</FilesMatch>

# game-data.js e app.js: cache lunga, il busting avviene via query ?v= in index.html
<FilesMatch "^(game-data|app)\.js$">
  Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>

# Compressione testo (HTML/CSS/JS/JSON/SVG/XML)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript text/javascript
  AddOutputFilterByType DEFLATE application/json application/manifest+json
  AddOutputFilterByType DEFLATE image/svg+xml application/xml
</IfModule>
